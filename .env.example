# --- Loontail Minecraft Network Service: example environment ---
# Copy to `.env` for local Docker Compose, or to `.env.prod` on Hetzner.
# Real .env files are git-ignored. Never commit secrets.

# HTTP API bind address (inside the container).
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Relay/tunnel WebSocket bind address (inside the container).
# Relay shares the same Axum server/port in this MVP; this is reserved for a
# future dedicated relay listener (see relay module TODO).
RELAY_PORT=8080

# Postgres connection. When running via docker-compose the host is the
# `postgres` service name. For host-side `sqlx`/`cargo run` use localhost.
DATABASE_URL=postgres://loontail:loontail@postgres:5432/loontail_network

# Postgres bootstrap credentials (consumed by the postgres container).
POSTGRES_USER=loontail
POSTGRES_PASSWORD=loontail
POSTGRES_DB=loontail_network

# CORS allow-list (comma-separated origins, or `*` for any).
CORS_ALLOWED_ORIGINS=*

# Network session token lifetime (seconds).
SESSION_TTL_SECONDS=86400

# A presence heartbeat older than this marks the user offline.
HEARTBEAT_TIMEOUT_SECONDS=60

# World / join limits.
MAX_PLAYERS_PER_WORLD=5
JOIN_REQUEST_TTL_SECONDS=60
JOIN_TICKET_TTL_SECONDS=60

# User search constraints.
SEARCH_MIN_QUERY_LENGTH=2
SEARCH_MAX_RESULTS=20

# tracing-subscriber filter.
RUST_LOG=info,loontail_minecraft_network_service=debug,sqlx=warn
