# --- loontail-launcher-api: example environment ---
# Copy to `.env` for local Docker Compose or host-side `cargo run`.
# Real .env files are git-ignored. Never commit secrets.
#
# On the server, `.env.prod` is written and kept in sync by the deploy workflow
# (scripts/deploy-remote.sh) — do not hand-author it from this file.
#
# NOTE: both compose files pass an explicit allow-list to the container
# (`environment:` blocks). A variable that is not in that list has no effect
# under `docker compose`, only for host-side `cargo run`. Currently not passed
# through: TRUSTED_PROXY, METRICS_TOKEN, INVITE_TTL_SECONDS,
# RATE_LIMIT_MAX_ATTEMPTS, RATE_LIMIT_WINDOW_SECONDS,
# REQUEST_LOG_RETENTION_DAYS, CATALOG_MEDIA_STORAGE_ROOT.

# HTTP API bind address (inside the container). Relay and signaling WebSockets
# share this server/port (`/relay/:id`, `/signaling`).
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Postgres connection for HOST-side `cargo run` / `sqlx` / psql only. The compose
# stack ignores this value and builds its own from the POSTGRES_* parts below, so
# pointing this at localhost cannot break `docker compose up`.
DATABASE_URL=postgres://loontail:loontail@localhost:5432/loontail_launcher

# Postgres bootstrap credentials (consumed by the postgres container).
POSTGRES_USER=loontail
POSTGRES_PASSWORD=loontail
POSTGRES_DB=loontail_launcher

# CORS allow-list (comma-separated origins, or `*` for any). Unset/empty means
# CLOSED — no cross-origin caller is allowed.
CORS_ALLOWED_ORIGINS=*

# REQUIRED when a reverse proxy (Caddy, nginx, Cloudflare) terminates the
# connection: take the client IP from `X-Forwarded-For` / `X-Real-IP` instead of
# the transport peer. Default false. Left false behind a proxy, every request
# looks like it comes from the proxy's IP, so the per-IP credential rate limiter
# below collapses into ONE global bucket and locks out every user of the
# deployment. Set true only when the immediate peer is a proxy you control that
# overwrites those headers.
# TRUSTED_PROXY=true

# Shared bearer token that authorizes `GET /metrics` for a header-only scraper.
# Empty/unset means /metrics is reachable only with an authenticated admin session.
# METRICS_TOKEN=

# Unified session token lifetime (seconds); issued by the Yggdrasil account
# login (`POST /api/auth/login`) and sent as the Bearer on every request.
SESSION_TTL_SECONDS=86400

# A presence heartbeat older than this marks the user offline.
HEARTBEAT_TIMEOUT_SECONDS=60

# World / join / invite limits.
MAX_PLAYERS_PER_WORLD=5
JOIN_REQUEST_TTL_SECONDS=60
JOIN_TICKET_TTL_SECONDS=60
INVITE_TTL_SECONDS=600

# User search constraints.
SEARCH_MIN_QUERY_LENGTH=2
SEARCH_MAX_RESULTS=20

# --- Rate limiting ---
# Per-IP sliding window on the unauthenticated credential endpoints
# (/admin/auth/login, /api/auth/login, /api/auth/register, and the Yggdrasil
# authserver authenticate/refresh pair). In-process state, lost on restart.
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Retention (hourly cleanup tick) ---
# Retention (days) for the request_logs table.
REQUEST_LOG_RETENTION_DAYS=7
# Retention (days) for terminal join requests/invites, spent join tickets and
# user_events (these back the admin analytics views, hence the longer window).
EVENT_RETENTION_DAYS=30

# --- Yggdrasil (Mojang-compatible auth) ---
# Public base of the Yggdrasil endpoints. MUST be absolute in any real deployment —
# a path-only value makes signed profiles advertise server-relative texture URLs the
# game client cannot fetch, and every skin silently falls back to Steve.
# e.g. https://cms.loontail.dev/api/yggdrasil
YGGDRASIL_PUBLIC_URL=/api/yggdrasil
# RSA keypair used to sign texture properties (generated if absent).
YGGDRASIL_KEY_PATH=data/yggdrasil/keys/active.key.pem
# Access/client token lifetime (seconds). Default 15 days.
YGGDRASIL_TOKEN_TTL_SECONDS=1296000
# Maximum concurrent token pairs per user (oldest evicted beyond this).
YGGDRASIL_MAX_TOKENS_PER_USER=10
# Allowed skin/cape domains advertised in /meta (comma-separated).
YGGDRASIL_SKIN_DOMAINS=.loontail.dev,localhost

# --- Textures (skin/cape storage) ---
TEXTURES_STORAGE_ROOT=data/textures

# --- Catalog media (build poster/background/titleImage/screenshots) ---
CATALOG_MEDIA_STORAGE_ROOT=data/catalog-media

# --- Bundle registry ---
BUNDLES_STORAGE_ROOT=data/bundle-registry
BUNDLES_PUBLIC_URL=/bundle-registry

# --- Admin panel ---
# Admin session cookie lifetime (seconds). Default 7 days.
ADMIN_SESSION_TTL_SECONDS=604800
# Name of the httpOnly admin session cookie.
ADMIN_COOKIE_NAME=loontail_admin
# Bootstrap admin seed. The user is created on startup only when a password is set.
ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_PASSWORD=change-me

# tracing-subscriber filter.
RUST_LOG=info,loontail_server=debug,loontail_network=debug,sqlx=warn

# --- Production only (docker-compose.prod.yml) ---
# Public domain Caddy serves over HTTPS; hard-fails the prod stack when unset.
# NETWORK_DOMAIN=launcher-api.loontail.dev
# LOONTAIL_IMAGE — pinned GHCR image ref; also hard-fails when unset, but it is
# injected by .github/workflows/deploy.yml, so it is never set by hand.
